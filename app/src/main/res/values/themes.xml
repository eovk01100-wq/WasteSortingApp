<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 버림가이드 테마: 밝은 창 + 초록 포인트 (다크 모드에서도 같은 모양) -->
    <style name="Base.Theme.WasteSorting" parent="Theme.Material3.Light.NoActionBar">
        <!-- 포인트 색 (버튼 글자, 로딩 막대, 입력칸 테두리 등) -->
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_green_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_green_text</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/brand_surface_soft</item>
        <item name="colorOnSecondaryContainer">@color/brand_ink</item>
        <item name="colorTertiary">@color/brand_green_dark</item>

        <!-- 바탕과 글자 -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/brand_ink</item>
        <item name="colorOnSurfaceVariant">@color/brand_gray</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="colorOutlineVariant">@color/brand_line</item>

        <!-- 창(다이얼로그) 바탕: 보랏빛 없이 흰색 -->
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/brand_surface_soft</item>
    </style>

    <style name="Theme.WasteSorting" parent="Base.Theme.WasteSorting" />
</resources>
